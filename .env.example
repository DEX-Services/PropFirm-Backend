# BitDX Prop Firm — backend environment (template, no secrets)
# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_CONNECTION_LIMIT=20

POSTGRES_SERVICE_URI=

# --- Redis (read-only price feed consumption) ---
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

REDIS_URL=

# --- Kafka (live-account risk-monitor event pipeline) ---
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=

KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# --- BitDX Prop Firm service config ---
PORT=8090
PROPFIRM_FRONTEND_ORIGIN=http://localhost:3001
PROPFIRM_ENGINE_URL=http://localhost:8080
PROPFIRM_JWT_SECRET=
PROPFIRM_INTERNAL_SECRET=
